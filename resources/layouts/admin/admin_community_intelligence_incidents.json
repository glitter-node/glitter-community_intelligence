{
  "version": "1.2.0",
  "layout_name": "admin_community_intelligence_incidents",
  "permissions": [
    "glitter-community_intelligence.intelligence.view"
  ],
  "extends": "_admin_base",
  "meta": {
    "title": "$t:glitter-community_intelligence.admin.incidents"
  },
  "transition_overlay": {
    "wait_for": [
      "incidents"
    ]
  },
  "data_sources": [
    {
      "id": "incidents",
      "type": "api",
      "endpoint": "/api/modules/glitter-community_intelligence/admin/incidents",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "loading_strategy": "progressive",
      "params": {
        "page": "{{query.page}}",
        "per_page": "{{query.per_page || 20}}"
      }
    }
  ],
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "Div",
        "props": {
          "className": "admin-page-content-fluid space-y-4"
        },
        "children": [
          {
            "type": "composite",
            "name": "PageHeader",
            "props": {
              "title": "$t:glitter-community_intelligence.admin.incidents",
              "description": "$t:glitter-community_intelligence.admin.notice"
            }
          },
          {
            "type": "composite",
            "name": "Alert",
            "if": "{{_dataSourceErrors?.incidents}}",
            "props": {
              "type": "error",
              "message": "$t:glitter-community_intelligence.admin.incidents_error"
            }
          },
          {
            "type": "basic",
            "name": "P",
            "if": "{{!_dataSourceErrors?.incidents && (incidents?.data?.data ?? []).length === 0}}",
            "text": "$t:glitter-community_intelligence.admin.incidents_empty"
          },
          {
            "type": "basic",
            "name": "Button",
            "iteration": {
              "source": "incidents?.data?.data ?? []",
              "item_var": "incident",
              "index_var": "idx"
            },
            "props": {
              "type": "button",
              "className": "admin-card block w-full text-left space-y-2"
            },
            "actions": [
              {
                "type": "click",
                "handler": "navigate",
                "params": {
                  "path": "/admin/community-intelligence/incidents/{{incident.id}}"
                }
              }
            ],
            "children": [
              {
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "flex flex-wrap items-center gap-2"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "H2",
                    "text": "$t:glitter-community_intelligence.admin.incident_title|id={{incident.id}}|type={{incident.type}}"
                  },
                  {
                    "type": "composite",
                    "name": "Badge",
                    "props": {
                      "text": "{{$t(\"glitter-community_intelligence.status.\" + incident.status)}}"
                    }
                  }
                ]
              },
              {
                "type": "basic",
                "name": "P",
                "text": "$t:glitter-community_intelligence.admin.subject|type={{incident.subject.type}}|id={{incident.subject.id}}"
              },
              {
                "type": "basic",
                "name": "P",
                "text": "$t:glitter-community_intelligence.admin.started_at|value={{incident.started_at | datetime}}"
              },
              {
                "type": "basic",
                "name": "P",
                "text": "$t:glitter-community_intelligence.admin.last_activity_at|value={{incident.last_activity_at | datetime}}"
              }
            ]
          }
        ]
      }
    ]
  }
}
