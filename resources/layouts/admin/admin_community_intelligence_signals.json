{
  "version": "1.2.0",
  "layout_name": "admin_community_intelligence_signals",
  "permissions": [
    "glitter-community_intelligence.intelligence.view"
  ],
  "extends": "_admin_base",
  "meta": {
    "title": "$t:glitter-community_intelligence.admin.signals"
  },
  "transition_overlay": {
    "wait_for": [
      "signals"
    ]
  },
  "data_sources": [
    {
      "id": "signals",
      "type": "api",
      "endpoint": "/api/modules/glitter-community_intelligence/admin/signals",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "loading_strategy": "progressive",
      "params": {
        "page": "{{query.page}}",
        "per_page": "{{query.per_page || 20}}",
        "type": "{{query.type}}",
        "status": "{{query.status}}"
      }
    }
  ],
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "Div",
        "props": {
          "className": "admin-page-content-fluid space-y-4"
        },
        "children": [
          {
            "type": "composite",
            "name": "PageHeader",
            "props": {
              "title": "$t:glitter-community_intelligence.admin.signals",
              "description": "$t:glitter-community_intelligence.admin.notice"
            }
          },
          {
            "type": "composite",
            "name": "Alert",
            "if": "{{_dataSourceErrors?.signals}}",
            "props": {
              "type": "error",
              "message": "$t:glitter-community_intelligence.admin.signals_error"
            }
          },
          {
            "type": "basic",
            "name": "P",
            "if": "{{!_dataSourceErrors?.signals && (signals?.data?.data ?? []).length === 0}}",
            "text": "$t:glitter-community_intelligence.admin.signals_empty"
          },
          {
            "type": "basic",
            "name": "Button",
            "iteration": {
              "source": "signals?.data?.data ?? []",
              "item_var": "signal",
              "index_var": "idx"
            },
            "props": {
              "type": "button",
              "className": "admin-card block w-full text-left space-y-2"
            },
            "actions": [
              {
                "type": "click",
                "handler": "navigate",
                "params": {
                  "path": "/admin/community-intelligence/signals/{{signal.id}}"
                }
              }
            ],
            "children": [
              {
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "flex flex-wrap items-center gap-2"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "H2",
                    "props": {
                      "className": "font-semibold"
                    },
                    "text": "{{$t(\"glitter-community_intelligence.signal_type.\" + signal.type)}}"
                  },
                  {
                    "type": "composite",
                    "name": "Badge",
                    "props": {
                      "variant": "{{signal.priority >= 75 ? 'danger' : signal.priority >= 50 ? 'warning' : 'secondary'}}",
                      "text": "{{$t(\"glitter-community_intelligence.priority.\" + (signal.priority >= 75 ? \"high\" : signal.priority >= 50 ? \"medium\" : \"low\"))}}"
                    }
                  },
                  {
                    "type": "basic",
                    "name": "Span",
                    "text": "{{signal.priority ?? 0}}"
                  },
                  {
                    "type": "basic",
                    "name": "Span",
                    "text": "{{$t(\"glitter-community_intelligence.status.\" + signal.status)}}"
                  }
                ]
              },
              {
                "type": "basic",
                "name": "P",
                "text": "$t:glitter-community_intelligence.admin.subject|type={{signal.subject.type}}|id={{signal.subject.id}}"
              },
              {
                "type": "basic",
                "name": "P",
                "text": "$t:glitter-community_intelligence.admin.rule_label|value={{signal.rule.identifier}}"
              },
              {
                "type": "basic",
                "name": "P",
                "text": "$t:glitter-community_intelligence.admin.detected_at|value={{signal.detected_at | datetime}}"
              }
            ]
          }
        ]
      }
    ]
  }
}
